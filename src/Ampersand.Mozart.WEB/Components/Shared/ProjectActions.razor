@inject ProjectOperationsService Ops
@inject PublishProfileService Profiles
@inject LaunchSettingsService Launch
@inject JobManager Jobs
@inject NavigationManager Nav
@implements IDisposable

<div class="actions">
    @if (_canRun)
    {
        @if (_runningRun is not null)
        {
            <button class="btn btn-sm btn-danger" @onclick="StopRunAsync">Stop</button>
            <a class="btn btn-sm btn-ghost" href="@($"/jobs/{_runningRun.Id}")">Console</a>
        }
        else
        {
            @if (_launchProfiles.Count > 1)
            {
                <select class="btn btn-sm" style="max-width:140px" @bind="_selectedLaunch" disabled="@Busy">
                    @foreach (var profile in _launchProfiles)
                    {
                        <option value="@profile.Name">@profile.Name</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-run" disabled="@Busy" @onclick="RunAsync">
                Run @(_selectedLaunch ?? _launchProfiles.FirstOrDefault()?.Name ?? "")
            </button>
        }
    }
    <button class="btn btn-sm" disabled="@Busy" @onclick="() => Run(p => Ops.Restore(p))">Restore</button>
    <button class="btn btn-sm btn-primary" disabled="@Busy" @onclick="() => Run(p => Ops.Build(p))">Build</button>
    <button class="btn btn-sm" disabled="@Busy" @onclick="() => Run(p => Ops.Test(p))">Tests</button>
    <button class="btn btn-sm" disabled="@Busy" @onclick="() => Run(p => Ops.Clean(p))">Clean</button>
    <button class="btn btn-sm" disabled="@Busy" @onclick="() => Run(p => Ops.GitPull(p))">git pull</button>
    <button class="btn btn-sm" disabled="@Busy" @onclick="() => Run(p => Ops.GitCommitPush(p))">commit+push</button>
    @if (_profiles.Count > 0)
    {
        @if (_profiles.Count > 1)
        {
            <select class="btn btn-sm" style="max-width:160px" @bind="_selected" disabled="@Busy">
                @foreach (var profile in _profiles)
                {
                    <option value="@profile.Name">@profile.Name</option>
                }
            </select>
        }
        <button class="btn btn-sm btn-ok" disabled="@Busy" @onclick="DeployAsync">
            Deploy @(_selected ?? _profiles[0].Name)
        </button>
    }
    @if (ShowOpen)
    {
        <a class="btn btn-sm btn-ghost" href="@($"/projects/{Project.Id}")">Open</a>
    }
</div>
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="flash flash-err" style="margin-top:8px">@_error</div>
}

@code {
    [Parameter, EditorRequired] public CicdProject Project { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowOpen { get; set; } = true;
    [Parameter] public bool NavigateToJob { get; set; }

    private IReadOnlyList<PublishProfileInfo> _profiles = [];
    private IReadOnlyList<LaunchProfileInfo> _launchProfiles = [];
    private Job? _runningRun;
    private bool _canRun;
    private string? _selected;
    private string? _selectedLaunch;
    private string? _error;
    private string? _loadedFor;

    protected override void OnInitialized() => Jobs.Changed += OnJobsChanged;

    protected override void OnParametersSet()
    {
        if (_loadedFor != Project.Id)
        {
            _profiles = Profiles.GetProfiles(Project);
            _loadedFor = Project.Id;
            var resolved = Profiles.ResolveDeployProfile(Project);
            _selected = resolved?.Name;

            _canRun = Launch.CanRun(Project);
            _launchProfiles = Launch.GetProfiles(Project);
            var defaultLaunch = Launch.ResolveDefaultProfile(Project, _launchProfiles);
            _selectedLaunch = defaultLaunch?.Name;
        }

        RefreshRunState();
    }

    private void OnJobsChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshRunState();
            StateHasChanged();
        });
    }

    public void Dispose() => Jobs.Changed -= OnJobsChanged;

    private void RefreshRunState() => _runningRun = Jobs.GetRunningRunJob(Project.Id);

    private void Run(Func<CicdProject, Job> start)
    {
        _error = null;
        var job = start(Project);
        if (NavigateToJob)
        {
            Nav.NavigateTo($"/jobs/{job.Id}");
        }
    }

    private void RunAsync()
    {
        _error = null;
        try
        {
            var job = Ops.Run(Project, _selectedLaunch);
            RefreshRunState();
            if (NavigateToJob)
            {
                Nav.NavigateTo($"/jobs/{job.Id}");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void StopRunAsync()
    {
        _error = null;
        Ops.StopRun(Project);
        RefreshRunState();
    }

    private async Task DeployAsync()
    {
        var name = _selected ?? _profiles.FirstOrDefault()?.Name;
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        _error = null;
        try
        {
            var job = await Ops.PublishAsync(Project, name);
            if (NavigateToJob)
            {
                Nav.NavigateTo($"/jobs/{job.Id}");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
